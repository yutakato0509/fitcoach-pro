// FitCoach Pro (pt-manager-57190) の Firestore セキュリティルール
// 注意：このファイルを置いただけでは本番ルールは変わりません。
// Firebase コンソール → Firestore Database → ルール に貼り付けて「公開」するか、
// Firebase CLI で `firebase deploy --only firestore:rules` を実行して初めて反映されます。
//
// 設計メモ：
// - trainers / pt_users は本人のみ読み書き
// - publicShares / clientViews は「リンクを知っている人が見られる」のが仕様
//   （share.html / client-view.html がログインなしで読む）。書き込みは所有者のみ。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /trainers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /pt_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /publicShares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.trainerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.trainerUid == request.auth.uid;
    }
    match /clientViews/{viewId} {
      allow read: if true;
      allow create, update: if request.auth != null
                    && request.resource.data.trainerUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.trainerUid == request.auth.uid;
    }
  }
}
